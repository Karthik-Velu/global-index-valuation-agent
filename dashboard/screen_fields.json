{
  "_comment": "Screen DSL field registry — the single source of truth for the browser (dashboard/screen-dsl.js), the AI screen builder (api/screen-builder.js) and the Python jobs (engine/screens.py). Registry only, no data. Percent fields are fractions (0.08 = 8%). 'growth: true' marks FUNDAMENTAL growth fields (revenue/earnings record); 'price_signal: true' marks fields that move with the share price and may never stand in for growth (ADR-037). Enum values equal the exact data values (stocks: engine/sectoragent/sic_map.py + universescan._COUNTRY_MAP; markets: engine/universe.py) and are checked against dashboard_data.json by the parity tests.",
  "version": 1,
  "scopes": ["stocks", "markets"],
  "reserved_scopes": ["portfolio"],
  "limits": {"max_conditions": 12, "max_columns": 20, "max_list_values": 500, "max_text_length": 80,
             "limit_min": 1, "limit_max": 500, "limit_default": 100},
  "type_ops": {
    "number": ["<", "<=", ">", ">=", "=", "!=", "between"],
    "percent": ["<", "<=", ">", ">=", "=", "!=", "between"],
    "money": ["<", "<=", ">", ">=", "=", "!=", "between"],
    "enum": ["=", "!=", "in", "not_in"],
    "text": ["=", "!=", "contains", "in", "not_in"],
    "list": ["contains"],
    "bool": ["is_true", "is_false"]
  },
  "groups": ["Valuation", "Growth record (fundamentals)", "Quality & consistency", "Price position", "Dividends",
             "Classification", "Strategies", "Data quality"],
  "fields": [
    {"key": "ticker", "label": "Ticker", "short": "Ticker", "type": "text", "scopes": ["stocks"],
     "group": "Classification", "source": "classification", "help": "US listing symbol.",
     "synonyms": ["ticker", "tickers", "symbol", "symbols"]},
    {"key": "key", "label": "Market id", "short": "Market", "type": "text", "scopes": ["markets"],
     "group": "Classification", "source": "classification", "help": "Internal market id, e.g. sec_tech.",
     "synonyms": ["market id"]},
    {"key": "symbol", "label": "ETF symbol", "short": "ETF", "type": "text", "scopes": ["markets"],
     "group": "Classification", "source": "classification",
     "help": "Ticker of the ETF used as the market's price proxy.",
     "synonyms": ["symbol", "etf", "etf symbol", "ticker"]},
    {"key": "name", "label": "Name", "short": "Name", "type": "text", "scopes": ["stocks", "markets"],
     "group": "Classification", "source": "classification", "help": "Company or market name.",
     "synonyms": ["name", "company name", "market name"]},
    {"key": "sector", "label": "Sector", "short": "Sector", "type": "enum", "scopes": ["stocks"],
     "group": "Classification", "source": "classification",
     "help": "Sector from the company's SEC industry code (not GICS).",
     "synonyms": ["sector", "sectors", "industry"],
     "enum": ["Technology", "Healthcare", "Communication Services", "Consumer Discretionary", "Consumer Staples",
              "Energy", "Financials", "Industrials", "Materials", "Real Estate", "Utilities", "Unknown"],
     "enum_synonyms": {
       "Technology": ["tech", "technology", "information technology", "it", "software", "semiconductors", "semis",
                      "tech stocks"],
       "Healthcare": ["health care", "healthcare", "health", "pharma", "pharmaceuticals", "biotech", "medical"],
       "Communication Services": ["communication services", "communications", "communication", "telecom",
                                  "telecoms", "media"],
       "Consumer Discretionary": ["consumer discretionary", "discretionary", "retail", "retailers"],
       "Consumer Staples": ["consumer staples", "staples"],
       "Energy": ["energy", "oil", "oil and gas", "oil & gas"],
       "Financials": ["financials", "financial", "finance", "banks", "banking", "insurance"],
       "Industrials": ["industrials", "industrial"],
       "Materials": ["materials", "mining", "miners", "chemicals", "basic materials"],
       "Real Estate": ["real estate", "reit", "reits", "property"],
       "Utilities": ["utilities", "utility"],
       "Unknown": ["unknown", "unclassified"]
     },
     "market_name_hint": {"Technology": "Technology", "Healthcare": "Health", "Communication Services": "Communication",
                          "Consumer Discretionary": "Discretionary", "Consumer Staples": "Staples",
                          "Energy": "Energy", "Financials": "Financ", "Industrials": "Industrials",
                          "Materials": "Materials", "Real Estate": "Real Estate", "Utilities": "Utilities"}},
    {"key": "kind", "label": "Market type", "short": "Type", "type": "enum", "scopes": ["markets"],
     "group": "Classification", "source": "classification",
     "help": "Country, sector, style, region or broad-market index.",
     "synonyms": ["kind", "type", "market type"],
     "enum": ["Country", "Sector", "Style", "Region", "Broad"],
     "enum_synonyms": {
       "Country": ["country", "countries", "country funds", "country markets", "country indices"],
       "Sector": ["sector", "sectors", "industries", "industry", "sector funds"],
       "Style": ["style", "styles", "factor", "factors"],
       "Region": ["region", "regions", "regional"],
       "Broad": ["broad", "broad market", "broad markets"]
     }},
    {"key": "region", "label": "Region", "short": "Region", "type": "enum", "scopes": ["markets"],
     "group": "Classification", "source": "classification", "help": "Geographic region of the market.",
     "synonyms": ["region"],
     "enum": ["North America", "Latin America", "Europe", "Emerging Europe", "Africa/MEA", "Asia-Pacific", "Global"],
     "enum_synonyms": {
       "North America": ["north america", "north american"],
       "Latin America": ["latin america", "latam", "south america", "latin american", "south american"],
       "Europe": ["europe", "european", "western europe"],
       "Emerging Europe": ["emerging europe", "eastern europe", "east europe"],
       "Africa/MEA": ["africa", "african", "middle east", "mea", "africa/mea", "gulf"],
       "Asia-Pacific": ["asia pacific", "asia-pacific", "asia", "asian", "apac", "pacific"],
       "Global": ["global", "world", "worldwide"]
     }},
    {"key": "development", "label": "Development", "short": "Dev.", "type": "enum", "scopes": ["markets"],
     "group": "Classification", "source": "classification", "help": "MSCI-style market classification.",
     "synonyms": ["development", "development level", "market status"],
     "enum": ["Developed", "Emerging", "Frontier", "Global"],
     "enum_synonyms": {
       "Developed": ["developed", "developed markets", "dm"],
       "Emerging": ["emerging", "emerging markets", "em"],
       "Frontier": ["frontier", "frontier markets"],
       "Global": ["global mix"]
     }},
    {"key": "country", "label": "Country", "short": "Country", "type": "enum", "scopes": ["stocks", "markets"],
     "group": "Classification", "source": "classification",
     "help": "Stocks: country of the company's main operations (EDGAR). Markets: country of the index; Global/Regional/Europe for multi-country indices.",
     "synonyms": ["country", "domicile"],
     "enum": ["United States", "Canada", "Mexico", "Brazil", "Argentina", "Chile", "Colombia", "Peru",
              "United Kingdom", "Ireland", "France", "Germany", "Netherlands", "Belgium", "Switzerland", "Austria",
              "Italy", "Spain", "Portugal", "Sweden", "Norway", "Denmark", "Finland", "Greece", "Poland", "Turkey",
              "Israel", "Saudi Arabia", "United Arab Emirates", "Qatar", "Egypt", "Nigeria", "South Africa",
              "China", "Hong Kong", "Taiwan", "South Korea", "Japan", "India", "Pakistan", "Singapore", "Malaysia",
              "Indonesia", "Thailand", "Philippines", "Vietnam", "Australia", "New Zealand",
              "Europe", "Regional", "Global"],
     "enum_synonyms": {
       "United States": ["us", "u.s.", "usa", "u.s.a.", "united states", "america", "american", "us listed",
                         "domestic"],
       "Canada": ["canadian"], "Mexico": ["mexican"], "Brazil": ["brazilian"],
       "Argentina": ["argentine", "argentinian"], "Chile": ["chilean"], "Colombia": ["colombian"],
       "Peru": ["peruvian"],
       "United Kingdom": ["uk", "u.k.", "britain", "great britain", "british", "england", "english"],
       "Ireland": ["irish"], "France": ["french"], "Germany": ["german"],
       "Netherlands": ["dutch", "holland", "the netherlands"], "Belgium": ["belgian"],
       "Switzerland": ["swiss"], "Austria": ["austrian"], "Italy": ["italian"], "Spain": ["spanish"],
       "Portugal": ["portuguese"], "Sweden": ["swedish"], "Norway": ["norwegian"], "Denmark": ["danish"],
       "Finland": ["finnish"], "Greece": ["greek"], "Poland": ["polish"], "Turkey": ["turkish", "turkiye"],
       "Israel": ["israeli"], "Saudi Arabia": ["saudi"],
       "United Arab Emirates": ["uae", "emirates", "emirati"], "Qatar": ["qatari"], "Egypt": ["egyptian"],
       "Nigeria": ["nigerian"], "South Africa": ["south african"], "China": ["chinese", "prc"],
       "Hong Kong": ["hk"], "Taiwan": ["taiwanese"], "South Korea": ["korea", "korean", "south korean"],
       "Japan": ["japanese"], "India": ["indian"], "Pakistan": ["pakistani"], "Singapore": ["singaporean"],
       "Malaysia": ["malaysian"], "Indonesia": ["indonesian"], "Thailand": ["thai"],
       "Philippines": ["filipino", "philippine"], "Vietnam": ["vietnamese", "viet nam"],
       "Australia": ["australian"], "New Zealand": ["nz", "kiwi"],
       "Europe": [], "Regional": ["multi country", "multi-country"], "Global": []
     }},

    {"key": "pe", "label": "P/E (price / earnings)", "short": "P/E", "type": "number", "scopes": ["stocks", "markets"],
     "group": "Valuation", "source": "price-derived", "min": 0, "max": 100000, "sort_default": "asc",
     "help": "Price divided by the latest annual net income; empty when earnings are negative.",
     "synonyms": ["p/e", "pe", "p/e ratio", "pe ratio", "price to earnings", "price/earnings",
                  "price earnings", "earnings multiple"]},
    {"key": "pb", "label": "P/B (price / book)", "short": "P/B", "type": "number", "scopes": ["stocks", "markets"],
     "group": "Valuation", "source": "price-derived", "min": 0, "max": 100000, "sort_default": "asc",
     "help": "Price divided by book value (shareholders' equity).",
     "synonyms": ["p/b", "pb", "p/b ratio", "pb ratio", "price to book", "price/book", "price book",
                  "book multiple"]},
    {"key": "ps", "label": "P/S (price / sales)", "short": "P/S", "type": "number", "scopes": ["stocks", "markets"],
     "group": "Valuation", "source": "price-derived", "min": 0, "max": 100000, "sort_default": "asc",
     "help": "Price divided by the latest annual revenue.",
     "synonyms": ["p/s", "ps", "p/s ratio", "ps ratio", "price to sales", "price/sales", "price sales",
                  "sales multiple"]},
    {"key": "pcf", "label": "P/CF (price / cash flow)", "short": "P/CF", "type": "number",
     "scopes": ["stocks", "markets"], "group": "Valuation", "source": "price-derived", "min": 0, "max": 100000,
     "sort_default": "asc", "help": "Price divided by the latest annual operating cash flow.",
     "synonyms": ["p/cf", "pcf", "p/cf ratio", "price to cash flow", "price/cash flow", "price cash flow",
                  "cash flow multiple"]},
    {"key": "value_score", "label": "Value score (0-100, vs peers)", "short": "Value", "type": "number",
     "scopes": ["stocks", "markets"], "group": "Valuation", "source": "model", "min": 0, "max": 100, "unit": "/100",
     "help": "How cheap vs its peer group (stocks: same sector; markets: same type), from P/E, P/B, P/S, P/CF and yield. 100 = cheapest.",
     "synonyms": ["value score", "valuation score", "cheapness score", "cheapness"]},
    {"key": "opportunity_score", "label": "Opportunity score (blend)", "short": "Opportunity", "type": "number",
     "scopes": ["stocks", "markets"], "group": "Valuation", "source": "model", "min": 0, "max": 100, "unit": "/100",
     "price_signal": true, "lexemes": ["opportunity"],
     "help": "blend: value + fundamental growth + 12% price momentum + 8% mean-reversion — not a growth measure",
     "synonyms": ["opportunity score", "opportunity"]},
    {"key": "market_cap", "label": "Market cap (USD)", "short": "Mkt cap", "type": "money", "scopes": ["stocks"],
     "group": "Valuation", "source": "price-derived", "min": 0, "max": 100000000000000, "unit": "USD",
     "help": "Share price x shares outstanding, in US dollars.",
     "synonyms": ["market cap", "market capitalization", "market capitalisation", "mkt cap", "mcap", "size"]},

    {"key": "rev_growth", "label": "Revenue growth (latest year)", "short": "Rev growth 1y", "type": "percent",
     "scopes": ["stocks", "markets"], "group": "Growth record (fundamentals)", "source": "edgar", "growth": true,
     "min": -1, "max": 5,
     "help": "Latest fiscal year revenue vs the year before. Markets: holdings-weighted.",
     "synonyms": ["revenue growth", "sales growth", "revenue growth last year", "top line growth",
                  "yoy revenue growth"]},
    {"key": "earnings_growth", "label": "Earnings growth (latest year)", "short": "EPS growth 1y", "type": "percent",
     "scopes": ["stocks", "markets"], "group": "Growth record (fundamentals)", "source": "edgar", "growth": true,
     "min": -50, "max": 50,
     "help": "Latest fiscal year net income vs the year before. Markets: holdings-weighted.",
     "synonyms": ["earnings growth", "profit growth", "net income growth", "eps growth", "earnings growth last year",
                  "yoy earnings growth"]},
    {"key": "rev_cagr", "label": "Revenue growth per year (multi-year CAGR)", "short": "Rev CAGR", "type": "percent",
     "scopes": ["stocks"], "group": "Growth record (fundamentals)", "source": "edgar", "growth": true,
     "min": -1, "max": 5,
     "help": "Compound annual revenue growth over up to the last six fiscal years (EDGAR).",
     "synonyms": ["revenue cagr", "sales cagr", "revenue growth rate", "multi year revenue growth",
                  "annual revenue growth", "long term revenue growth"]},
    {"key": "ni_cagr", "label": "Earnings growth per year (multi-year CAGR)", "short": "Earnings CAGR",
     "type": "percent", "scopes": ["stocks"], "group": "Growth record (fundamentals)", "source": "edgar",
     "growth": true, "min": -1, "max": 5,
     "help": "Compound annual net-income growth over up to the last six fiscal years (EDGAR).",
     "synonyms": ["earnings cagr", "net income cagr", "profit cagr", "earnings growth rate",
                  "multi year earnings growth", "annual earnings growth", "long term earnings growth"]},
    {"key": "fwd_growth", "label": "Forward earnings growth (analyst estimates)", "short": "Fwd growth",
     "type": "percent", "scopes": ["markets"], "group": "Growth record (fundamentals)", "source": "model",
     "growth": true, "min": -10, "max": 10,
     "help": "Analysts' expected earnings growth for the index's holdings.",
     "synonyms": ["forward growth", "forward earnings growth", "expected growth", "estimated growth",
                  "fwd growth"]},
    {"key": "growth_score", "label": "Growth score (0-100, fundamentals vs peers)", "short": "Growth",
     "type": "number", "scopes": ["stocks", "markets"], "group": "Growth record (fundamentals)", "source": "model",
     "growth": true, "min": 0, "max": 100, "unit": "/100",
     "help": "Revenue and earnings growth ranked within peers (stocks: multi-year record weighted most). Never price momentum.",
     "synonyms": ["growth score", "fundamental growth score"]},

    {"key": "rev_up_ratio", "label": "Revenue up (share of years)", "short": "Revenue up", "type": "percent",
     "scopes": ["stocks"], "group": "Quality & consistency", "source": "edgar", "growth": true, "min": 0, "max": 1,
     "unit": "of years", "help": "Share of the last (up to six) fiscal years in which revenue grew.",
     "synonyms": ["revenue up", "revenue up ratio", "revenue up years", "years of revenue growth"]},
    {"key": "ni_up_ratio", "label": "Earnings up (share of years)", "short": "Earnings up", "type": "percent",
     "scopes": ["stocks"], "group": "Quality & consistency", "source": "edgar", "growth": true, "min": 0, "max": 1,
     "unit": "of years", "help": "Share of the last (up to six) fiscal years in which net income grew.",
     "synonyms": ["earnings up", "earnings up ratio", "earnings up years", "years of earnings growth"]},
    {"key": "ni_pos_ratio", "label": "Profitable (share of years)", "short": "Profitable", "type": "percent",
     "scopes": ["stocks"], "group": "Quality & consistency", "source": "edgar", "growth": true, "min": 0, "max": 1,
     "unit": "of years", "help": "Share of the last (up to seven) fiscal years with positive net income.",
     "synonyms": ["profitable years", "years profitable", "profitability record"]},
    {"key": "consistency_score", "label": "Consistency score (0-100, vs peers)", "short": "Consistency",
     "type": "number", "scopes": ["stocks"], "group": "Quality & consistency", "source": "model", "growth": true,
     "min": 0, "max": 100, "unit": "/100",
     "help": "How steadily revenue and earnings grew (up-years, profitable years, low volatility), ranked within sector.",
     "synonyms": ["consistency score", "consistency", "growth consistency"]},
    {"key": "hist_years", "label": "Years of reported history", "short": "History", "type": "number",
     "scopes": ["stocks"], "group": "Quality & consistency", "source": "edgar", "min": 0, "max": 50,
     "unit": "years", "help": "Number of yearly changes in the cleaned annual series (up to six).",
     "synonyms": ["years of history", "history years", "history", "reporting history"]},

    {"key": "price", "label": "Share price (USD)", "short": "Price", "type": "money", "scopes": ["stocks"],
     "group": "Price position", "source": "price-derived", "price_signal": true, "min": 0, "max": 10000000,
     "unit": "USD", "lexemes": ["price", "priced", "dollar", "$"],
     "help": "Latest split-adjusted close.", "synonyms": ["share price", "stock price", "price"]},
    {"key": "discount_long", "label": "vs long-run average", "short": "vs long-run avg", "type": "percent",
     "scopes": ["stocks", "markets"], "group": "Price position", "source": "price-derived", "price_signal": true,
     "min": -1, "max": 20,
     "lexemes": ["below average", "above average", "below its", "above its", "below their", "above their",
                 "average price", "long run average", "long-run average", "year average", "discount", "on sale",
                 "cheap vs", "cheap versus", "cheap relative", "vs average", "versus average", "vs its average"],
     "help": "Price vs its own long-run average close: up to 5 years, or all the price history on file if shorter (see 'Long-run average window'). -0.10 = 10% below.",
     "synonyms": ["vs long run average", "versus long run average", "discount to average",
                  "vs average price", "long run discount"]},
    {"key": "long_avg_years", "label": "Long-run average window (years)", "short": "Avg window", "type": "number",
     "scopes": ["stocks", "markets"], "group": "Price position", "source": "price-derived", "min": 0, "max": 10,
     "unit": "years",
     "help": "Years of prices behind the long-run average (markets: 5; stocks: ~2 until more price history is on file).",
     "synonyms": ["average window", "long average window", "long run average window"]},
    {"key": "turning_up", "label": "Turning up (price recovering)", "short": "Turning up", "type": "bool",
     "scopes": ["stocks", "markets"], "group": "Price position", "source": "price-derived", "price_signal": true,
     "lexemes": ["turning", "rebound", "recover", "bounce", "momentum", "return"],
     "help": "Quality on sale AND up over the last month and off its 52-week low (price returns, ret_1m).",
     "synonyms": ["turning up", "turning around", "rebounding", "recovering"]},
    {"key": "value_trap", "label": "Value trap (price falling)", "short": "Value trap", "type": "bool",
     "label_false": "Not a value trap", "scopes": ["stocks", "markets"], "group": "Price position",
     "source": "price-derived", "price_signal": true,
     "lexemes": ["trap", "falling", "momentum", "return", "drawdown"],
     "help": "Cheap but deeply down and still falling (ret_12m and 52-week drawdown) — a price-only flag.",
     "synonyms": ["value trap", "value traps"]},

    {"key": "dividend_yield", "label": "Dividend yield", "short": "Yield", "type": "percent",
     "scopes": ["stocks", "markets"], "group": "Dividends", "source": "price-derived", "min": 0, "max": 1,
     "help": "Trailing-12-month dividends per share / price. 0 = pays no dividend.",
     "synonyms": ["dividend yield", "dividend", "dividends", "yield", "div yield"]},

    {"key": "on_sale", "label": "Quality on sale", "short": "On sale", "type": "bool",
     "scopes": ["stocks", "markets"], "group": "Strategies", "source": "model",
     "help": "Fundamentally strong, plausible data, and at least 10% below its long-run average price.",
     "synonyms": ["on sale", "quality on sale"]},
    {"key": "deep_value_intact", "label": "Deep discount, fundamentals intact", "short": "Deep value",
     "type": "bool", "scopes": ["stocks", "markets"], "group": "Strategies", "source": "model",
     "help": "Quality on sale, at least 20% below its long-run average, and value score 60+.",
     "synonyms": ["deep value intact", "deep value", "deep discount"]},
    {"key": "fundamentally_strong", "label": "Fundamentally strong", "short": "Strong", "type": "bool",
     "scopes": ["stocks", "markets"], "group": "Strategies", "source": "model", "growth": true,
     "help": "Profitable, growing (a multi-year record where available), growth at least median vs peers, not expensive.",
     "synonyms": ["fundamentally strong", "strong fundamentals", "high quality", "quality"]},
    {"key": "steady_compounder", "label": "Steady compounder", "short": "Steady", "type": "bool",
     "scopes": ["stocks"], "group": "Strategies", "source": "model", "growth": true,
     "help": "Revenue and earnings up in at least 80% of years, profitable every year, low volatility, CAGR >= 3%.",
     "synonyms": ["steady compounders", "steady compounder", "steady compounding", "compounders", "compounder"]},
    {"key": "garp", "label": "GARP (cheap + high fundamental growth)", "short": "GARP", "type": "bool",
     "scopes": ["stocks", "markets"], "group": "Strategies", "source": "model", "growth": true,
     "help": "Value score 55+, growth score 75+, not in the expensive cohort.",
     "synonyms": ["garp", "growth at a reasonable price"]},
    {"key": "strategies", "label": "Strategy tags", "short": "Strategies", "type": "text", "list": true,
     "scopes": ["stocks", "markets"], "group": "Strategies", "source": "model",
     "help": "Strategy keys the row qualifies for: on_sale, deep_value_intact, turning_up, steady_on_sale.",
     "synonyms": ["strategies", "strategy", "strategy tags"]},

    {"key": "data_ok", "label": "Passes data checks", "short": "Data OK", "type": "bool",
     "label_false": "Fails data checks", "scopes": ["stocks", "markets"], "group": "Data quality",
     "source": "model",
     "help": "Stocks: plausible ratios, US-domiciled, USD reporter, enough history, no open data-quality flag. Markets: plausible ratios.",
     "synonyms": ["data ok", "clean data", "passes data checks"]},
    {"key": "data_flags", "label": "Data flags", "short": "Flags", "type": "text", "list": true,
     "scopes": ["stocks"], "group": "Data quality", "source": "model",
     "help": "Why a row is hidden: implausible_pe, implausible_ps, below_min_mcap, foreign_listing, non_usd_reporter, short_history, quality:<check>.",
     "synonyms": ["data flags", "flags", "data issues"]},
    {"key": "growth_cov", "label": "Growth coverage (share of holdings)", "short": "Growth cov.",
     "type": "percent", "scopes": ["markets"], "group": "Data quality", "source": "model", "min": 0, "max": 1,
     "help": "Share of the index's holdings with fundamental growth data.",
     "synonyms": ["growth coverage", "coverage"]}
  ],
  "presets": [
    {"id": "stk_on_sale", "name": "Quality on sale", "scope": "stocks",
     "filter": {"v": 1, "scope": "stocks", "where": [{"field": "on_sale", "op": "is_true"}],
                "sort": {"field": "discount_long", "dir": "asc"}}},
    {"id": "stk_steady", "name": "Steady compounders", "scope": "stocks",
     "filter": {"v": 1, "scope": "stocks", "where": [{"field": "steady_compounder", "op": "is_true"}],
                "sort": {"field": "consistency_score", "dir": "desc"}}},
    {"id": "stk_deep_value", "name": "Deep value intact", "scope": "stocks",
     "filter": {"v": 1, "scope": "stocks", "where": [{"field": "deep_value_intact", "op": "is_true"}],
                "sort": {"field": "value_score", "dir": "desc"}}},
    {"id": "stk_cheap_growing", "name": "Cheap + growing", "scope": "stocks",
     "filter": {"v": 1, "scope": "stocks",
