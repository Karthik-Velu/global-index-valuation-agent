# Copy to .env and fill in. The engine runs WITHOUT this key — LLM insights are
# simply skipped, so data + scoring + dashboard all work for free.
ANTHROPIC_API_KEY=

# Differential model routing. Override per task tier if you want.
# Cheap tier handles high-volume tagging/classification; smart tier handles the
# single low-volume top-level synthesis.
MODEL_CHEAP=claude-haiku-4-5-20251001
MODEL_SMART=claude-opus-4-8
