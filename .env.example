# Copy to .env and fill in. .env is gitignored — secrets never get committed.
# The engine runs WITHOUT any of these (deterministic fallbacks); they unlock
# the LLM narrative, the cloud DB, and extra data sources.

# --- LLM (optional; WATERFALL model routing) ---
# Engine runs free without any of these (deterministic fallbacks). Each role has an
# ordered chain: tier 1 is tried first, and on rate-limit/error the router falls
# through to the next. Set just the provider key(s) you have — unavailable tiers are
# skipped. See docs/MODEL_ROUTING.md for the full design.
#
# Provider keys (set one or more):
ANTHROPIC_API_KEY=
GROQ_API_KEY=            # console.groq.com — free tier, fast 70B (good tier-1 for agents)
OPENROUTER_API_KEY=      # openrouter.ai — many :free models
DEEPSEEK_API_KEY=
ZAI_API_KEY=             # GLM-4-Flash (scheme glm:/zai:)
OLLAMA_BASE_URL=http://localhost:11434/v1   # local Ollama ($0, offline)
OLLAMA_API_KEY=          # set for Ollama Cloud (remote endpoint, big free-tier models)
#
# Optional: override the default best-first chains (comma-separated scheme:model).
# MODEL_AGENT_CHAIN=groq:llama-3.3-70b-versatile, ollama:qwen2.5
# MODEL_CHEAP_CHAIN=
# MODEL_SMART_CHAIN=
# ADAPTIVE_ROUTING=false   # true = let the learned scorecard reorder chains by reliability

# --- Semantic memory (engine/memory.py; see docs/MEMORY.md) ---
# Embedding model for relevance retrieval. Free + local; dim must match (768).
# No model -> retrieval falls back to lexical + scope (still works). To enable:
#   ollama pull nomic-embed-text
MODEL_EMBED=ollama:nomic-embed-text
# EMBED_DIM=768
# Lifecycle thresholds (defaults are sensible):
# MEM_ACTIVATE_EVIDENCE=2
# MEM_ACTIVATE_CONF=0.60
# MEM_PROMOTE_CONF=0.85
# MEM_DECAY_HALFLIFE_DAYS=180

# --- Supabase  (Tier A: relational state — Phase 1) ---
# Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Settings -> Database -> Connection string (URI). Prefer the "Session pooler"
# URI (IPv4, works from CI); put your saved DB password where it says [YOUR-PASSWORD].
DATABASE_URL=

# --- Tier B: bulk time-series Parquet, queried by DuckDB ---
# Local directory for the store (default data/tierb). Hydrate a fresh environment
# with:  python -m engine.tierbsync pull
# TIERB_ROOT=

# --- Cloudflare R2  (Tier B remote home — the later flip; local-first for now) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=giva-timeseries

# --- Optional data-source keys ---
SIMFIN_API_KEY=
