{
  "_comment": "Screen DSL parity vectors. 'validate', 'evaluate' and 'presets' run under BOTH node scripts/test_screens.js and python tests/test_screens.py and must give identical results; 'parse', 'guard' and 'describe' are JS-only (the Python side never parses language). Synthetic data only (tests/fixtures/screen_*.json, tickers FXA..FXN). In inline rows {\"$num\": \"NaN\"} / {\"$num\": \"Infinity\"} stand for non-finite numbers JSON can't carry. Expectation keys present are compared exactly; absent keys are not checked.",
  "validate": [
    {"name": "normalises numeric strings and sorts between bounds", "filter":
      {"scope": "stocks", "where": [{"field": "pe", "op": "<=", "value": "20"},
                                   {"field": "dividend_yield", "op": "between", "value": [0.06, "0.02"]},
                                   {"field": "pe", "op": ">", "value": "1e1"}]},
     "expect": {"ok": true, "errors": [], "filter": {"v": 1, "scope": "stocks",
       "where": [{"field": "pe", "op": "<=", "value": 20},
                 {"field": "dividend_yield", "op": "between", "value": [0.02, 0.06]},
                 {"field": "pe", "op": ">", "value": 10}],
       "sort": null, "limit": 100, "include_flagged": false}}},
    {"name": "scope taken from the argument when the filter has none", "scope": "markets", "filter": {"where": null},
     "expect": {"ok": true, "filter": {"v": 1, "scope": "markets", "where": [], "sort": null, "limit": 100, "include_flagged": false}}},
    {"name": "scope mismatch", "scope": "markets", "filter": {"scope": "stocks", "where": []},
     "expect": {"ok": false, "filter": null, "errors": ["filter.scope: 'stocks' does not match the requested scope 'markets'"]}},
    {"name": "portfolio scope reserved for PR 2", "filter": {"scope": "portfolio", "where": []},
     "expect": {"ok": false, "errors": ["filter.scope: 'portfolio' is not available yet"]}},
    {"name": "missing scope", "filter": {},
     "expect": {"ok": false, "errors": ["filter.scope: must be one of stocks, markets"]}},
    {"name": "prototype key as scope", "filter": {"scope": "__proto__"},
     "expect": {"ok": false, "errors": ["filter.scope: must be one of stocks, markets"]}},
    {"name": "filter is a list", "filter": [], "expect": {"ok": false, "filter": null, "errors": ["filter: must be an object"]}},
    {"name": "filter is null", "filter": null, "expect": {"ok": false, "errors": ["filter: must be an object"]}},
    {"name": "filter is a string", "filter": "pe < 20", "expect": {"ok": false, "errors": ["filter: must be an object"]}},
    {"name": "unknown top-level keys incl. prototype names", "filter":
      {"scope": "stocks", "__proto__": {"x": 1}, "constructor": 1, "explanation": "model text"},
     "expect": {"ok": false, "errors": ["filter.__proto__: unknown key", "filter.constructor: unknown key", "filter.explanation: unknown key"]}},
    {"name": "prototype-pollution field names", "filter": {"scope": "stocks", "where": [
       {"field": "__proto__", "op": "=", "value": 1}, {"field": "constructor", "op": "=", "value": 1},
       {"field": "toString", "op": "=", "value": 1}, {"field": "hasOwnProperty", "op": "=", "value": 1}]},
     "expect": {"ok": false, "errors": ["where[0].field: unknown field '__proto__'", "where[1].field: unknown field 'constructor'",
       "where[2].field: unknown field 'toString'", "where[3].field: unknown field 'hasOwnProperty'"]}},
    {"name": "prototype-pollution op names", "filter": {"scope": "stocks", "where": [
       {"field": "pe", "op": "__proto__", "value": 1}, {"field": "pe", "op": "constructor", "value": 1},
       {"field": "pe", "op": "toString", "value": 1}]},
     "expect": {"ok": false, "errors": [
       "where[0].op: '__proto__' is not allowed for P/E (use <, <=, >, >=, =, !=, between)",
       "where[1].op: 'constructor' is not allowed for P/E (use <, <=, >, >=, =, !=, between)",
       "where[2].op: 'toString' is not allowed for P/E (use <, <=, >, >=, =, !=, between)"]}},
    {"name": "prototype key in a sort and a column", "filter": {"scope": "stocks", "sort": {"field": "constructor"}, "columns": ["pe", "__proto__"]},
     "expect": {"ok": false, "errors": ["filter.sort.field: unknown field 'constructor'", "filter.columns[1]: unknown field '__proto__'"]}},
    {"name": "stock-only field in markets scope", "filter": {"scope": "markets", "where": [{"field": "rev_cagr", "op": ">", "value": 0}]},
     "expect": {"ok": false, "errors": ["where[0].field: 'rev_cagr' is not available for markets"]}},
    {"name": "market-only field in stocks scope", "filter": {"scope": "stocks", "where": [{"field": "region", "op": "=", "value": "Europe"}]},
     "expect": {"ok": false, "errors": ["where[0].field: 'region' is not available for stocks"]}},
    {"name": "too many conditions", "filter": {"scope": "stocks", "where": [
       {"field": "pe", "op": ">", "value": 1}, {"field": "pe", "op": ">", "value": 1}, {"field": "pe", "op": ">", "value": 1},
       {"field": "pe", "op": ">", "value": 1}, {"field": "pe", "op": ">", "value": 1}, {"field": "pe", "op": ">", "value": 1},
       {"field": "pe", "op": ">", "value": 1}, {"field": "pe", "op": ">", "value": 1}, {"field": "pe", "op": ">", "value": 1},
       {"field": "pe", "op": ">", "value": 1}, {"field": "pe", "op": ">", "value": 1}, {"field": "pe", "op": ">", "value": 1},
       {"field": "pe", "op": ">", "value": 1}]},
     "expect": {"ok": false, "errors": ["filter.where: at most 12 conditions (got 13)"]}},
    {"name": "enum synonyms: tech -> Technology, health care -> Healthcare", "filter": {"scope": "stocks", "where": [
       {"field": "sector", "op": "=", "value": "tech"},
       {"field": "sector", "op": "in", "value": ["health care", "IT", "Pharma", "technology"]},
       {"field": "country", "op": "not_in", "value": "usa"}]},
     "expect": {"ok": true, "filter": {"v": 1, "scope": "stocks", "where": [
       {"field": "sector", "op": "=", "value": "Technology"},
       {"field": "sector", "op": "in", "value": ["Healthcare", "Technology"]},
       {"field": "country", "op": "not_in", "value": ["United States"]}],
       "sort": null, "limit": 100, "include_flagged": false}}},
    {"name": "market enum synonyms", "filter": {"scope": "markets", "where": [
       {"field": "region", "op": "in", "value": ["asia", "LATAM", "middle east"]},
       {"field": "kind", "op": "=", "value": "Sectors"},
       {"field": "development", "op": "!=", "value": "EM"}]},
     "expect": {"ok": true, "filter": {"v": 1, "scope": "markets", "where": [
       {"field": "region", "op": "in", "value": ["Asia-Pacific", "Latin America", "Africa/MEA"]},
       {"field": "kind", "op": "=", "value": "Sector"},
       {"field": "development", "op": "!=", "value": "Emerging"}],
       "sort": null, "limit": 100, "include_flagged": false}}},
    {"name": "GICS name is rejected with the closest real sectors", "filter": {"scope": "stocks", "where": [
       {"field": "sector", "op": "=", "value": "Information Tech"}]},
     "expect": {"ok": false, "errors": ["where[0].value: 'Information Tech' is not a valid Sector (closest: Technology, Healthcare, Financials)"]}},
    {"name": "unknown value inside an in-list", "filter": {"scope": "stocks", "where": [
       {"field": "sector", "op": "in", "value": ["tech", "Narnia"]}]},
     "expect": {"ok": false, "errors": ["where[0].value[1]: 'Narnia' is not a valid Sector (closest: Healthcare, Communication Services, Financials)"]}},
    {"name": "number ranges", "filter": {"scope": "stocks", "where": [
       {"field": "value_score", "op": ">=", "value": 150}, {"field": "dividend_yield", "op": ">", "value": 3},
       {"field": "pe", "op": "<", "value": -1}, {"field": "value_score", "op": "between", "value": [50, -5]}]},
     "expect": {"ok": false, "errors": ["where[0].value: 150 is above the maximum 100 for Value",
       "where[1].value: 3 is above the maximum 1 for Yield", "where[2].value: -1 is below the minimum 0 for P/E",
       "where[3].value: -5 is below the minimum 0 for Value"]}},
    {"name": "non-numbers for number fields", "filter": {"scope": "stocks", "where": [
       {"field": "pe", "op": "<", "value": "abc"}, {"field": "pe", "op": "<", "value": "NaN"},
       {"field": "pe", "op": "<", "value": "Infinity"}, {"field": "pe", "op": "<", "value": true},
       {"field": "pe", "op": "<", "value": null}, {"field": "pe", "op": "<", "value": [1]}, {"field": "pe", "op": "<"}]},
     "expect": {"ok": false, "errors": ["where[0].value: must be a number", "where[1].value: must be a number",
       "where[2].value: must be a number", "where[3].value: must be a number", "where[4].value: must be a number",
       "where[5].value: must be a number", "where[6].value: must be a number"]}},
    {"name": "between shapes", "filter": {"scope": "stocks", "where": [
       {"field": "pe", "op": "between", "value": [1]}, {"field": "pe", "op": "between", "value": [1, "x"]},
       {"field": "pe", "op": "between", "value": 5}]},
     "expect": {"ok": false, "errors": ["where[0].value: between needs [low, high]", "where[1].value: between needs two numbers",
       "where[2].value: between needs [low, high]"]}},
    {"name": "bool shorthand and is_true/is_false", "filter": {"scope": "stocks", "where": [
       {"field": "on_sale", "op": "=", "value": true}, {"field": "value_trap", "op": "!=", "value": true},
       {"field": "garp", "op": "=", "value": "false"}, {"field": "steady_compounder", "op": "is_true", "value": true},
       {"field": "data_ok", "op": "is_false"}]},
     "expect": {"ok": true, "filter": {"v": 1, "scope": "stocks", "where": [
       {"field": "on_sale", "op": "is_true"}, {"field": "value_trap", "op": "is_false"}, {"field": "garp", "op": "is_false"},
       {"field": "steady_compounder", "op": "is_true"}, {"field": "data_ok", "op": "is_false"}],
       "sort": null, "limit": 100, "include_flagged": false}}},
    {"name": "bad ops per type", "filter": {"scope": "stocks", "where": [
       {"field": "on_sale", "op": "=", "value": "yes"}, {"field": "on_sale", "op": ">", "value": 1},
       {"field": "sector", "op": "contains", "value": "tech"}, {"field": "strategies", "op": "=", "value": "on_sale"},
       {"field": "pe", "op": "in", "value": [1, 2]}]},
     "expect": {"ok": false, "errors": [
       "where[0].op: '=' is not allowed for On sale (use is_true, is_false)",
       "where[1].op: '>' is not allowed for On sale (use is_true, is_false)",
       "where[2].op: 'contains' is not allowed for Sector (use =, !=, in, not_in)",
       "where[3].op: '=' is not allowed for Strategies (use contains)",
       "where[4].op: 'in' is not allowed for P/E (use <, <=, >, >=, =, !=, between)"]}},
    {"name": "text values trimmed, single in-value wrapped, duplicates dropped", "filter": {"scope": "stocks", "where": [
       {"field": "name", "op": "contains", "value": "  bank  "}, {"field": "ticker", "op": "in", "value": "FXA"},
       {"field": "ticker", "op": "not_in", "value": [" FXA ", "FXA", "FXB"]}, {"field": "strategies", "op": "contains", "value": "on_sale"}]},
     "expect": {"ok": true, "filter": {"v": 1, "scope": "stocks", "where": [
       {"field": "name", "op": "contains", "value": "bank"}, {"field": "ticker", "op": "in", "value": ["FXA"]},
       {"field": "ticker", "op": "not_in", "value": ["FXA", "FXB"]}, {"field": "strategies", "op": "contains", "value": "on_sale"}],
       "sort": null, "limit": 100, "include_flagged": false}}},
    {"name": "bad text values", "filter": {"scope": "stocks", "where": [
       {"field": "name", "op": "contains", "value": "   "},
       {"field": "name", "op": "contains", "value": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"},
       {"field": "ticker", "op": "in", "value": []}, {"field": "ticker", "op": "in", "value": ["FXA", 5]},
       {"field": "name", "op": "=", "value": 5}]},
     "expect": {"ok": false, "errors": ["where[0].value: must not be empty", "where[1].value: at most 80 characters",
       "where[2].value: must be a non-empty list", "where[3].value[1]: must be a string", "where[4].value: must be a string"]}},
    {"name": "malformed conditions", "filter": {"scope": "stocks", "where": [
       "pe < 20", {"field": "pe", "op": "<", "value": 1, "note": "x"}, {"field": 5, "op": "<"},
       {"field": "pe", "op": 5}, {"field": "pe"}, null]},
     "expect": {"ok": false, "errors": ["where[0]: must be an object", "where[1].note: unknown key", "where[2].field: must be a string",
       "where[3].op: must be a string", "where[4].op: must be a string", "where[5]: must be an object"]}},
    {"name": "where must be a list", "filter": {"scope": "stocks", "where": {"field": "pe"}},
     "expect": {"ok": false, "errors": ["filter.where: must be a list"]}},
    {"name": "sort default dir and limit coercion", "filter": {"scope": "stocks", "sort": {"field": "pe"}, "limit": "20", "include_flagged": true},
     "expect": {"ok": true, "filter": {"v": 1, "scope": "stocks", "where": [], "sort": {"field": "pe", "dir": "desc"}, "limit": 20, "include_flagged": true}}},
    {"name": "sort errors", "filter": {"scope": "stocks", "sort": {"field": "strategies", "dir": "up", "by": 1}},
     "expect": {"ok": false, "errors": ["filter.sort.by: unknown key", "filter.sort.field: 'strategies' cannot be sorted", "filter.sort.dir: must be 'asc' or 'desc'"]}},
    {"name": "sort must be an object", "filter": {"scope": "stocks", "sort": "pe"},
     "expect": {"ok": false, "errors": ["filter.sort: must be an object or null"]}},
    {"name": "sort field out of scope", "filter": {"scope": "markets", "sort": {"field": "rev_cagr", "dir": "asc"}},
     "expect": {"ok": false, "errors": ["filter.sort.field: 'rev_cagr' is not available for markets"]}},
    {"name": "limit out of range", "filter": {"scope": "stocks", "limit": 0},
     "expect": {"ok": false, "errors": ["filter.limit: must be a whole number from 1 to 500"]}},
    {"name": "limit above max", "filter": {"scope": "stocks", "limit": 501},
     "expect": {"ok": false, "errors": ["filter.limit: must be a whole number from 1 to 500"]}},
    {"name": "limit fractional", "filter": {"scope": "stocks", "limit": 20.5},
     "expect": {"ok": false, "errors": ["filter.limit: must be a whole number from 1 to 500"]}},
    {"name": "limit boolean", "filter": {"scope": "stocks", "limit": true},
     "expect": {"ok": false, "errors": ["filter.limit: must be a whole number from 1 to 500"]}},
    {"name": "include_flagged must be boolean", "filter": {"scope": "stocks", "include_flagged": "yes"},
     "expect": {"ok": false, "errors": ["filter.include_flagged: must be true or false"]}},
    {"name": "columns deduplicated", "filter": {"scope": "stocks", "columns": ["pe", "pe", "name"]},
     "expect": {"ok": true, "filter": {"v": 1, "scope": "stocks", "where": [], "sort": null, "limit": 100, "include_flagged": false, "columns": ["pe", "name"]}}},
    {"name": "empty columns kept", "filter": {"scope": "markets", "columns": []},
     "expect": {"ok": true, "filter": {"v": 1, "scope": "markets", "where": [], "sort": null, "limit": 100, "include_flagged": false, "columns": []}}},
    {"name": "columns errors", "filter": {"scope": "markets", "columns": ["rev_cagr", 5]},
     "expect": {"ok": false, "errors": ["filter.columns[0]: 'rev_cagr' is not available for markets", "filter.columns[1]: unknown field '5'"]}},
    {"name": "too many columns", "filter": {"scope": "stocks", "columns": ["pe", "pb", "ps", "pcf", "name", "ticker", "sector", "country", "price",
       "market_cap", "value_score", "growth_score", "rev_cagr", "ni_cagr", "rev_growth", "earnings_growth", "dividend_yield",
       "discount_long", "long_avg_years", "on_sale", "garp"]},
     "expect": {"ok": false, "errors": ["filter.columns: at most 20 fields"]}},
    {"name": "columns must be a list", "filter": {"scope": "stocks", "columns": "pe"},
     "expect": {"ok": false, "errors": ["filter.columns: must be a list of field keys"]}},
    {"name": "version must be 1", "filter": {"v": 2, "scope": "stocks"},
     "expect": {"ok": false, "errors": ["filter.v: must be 1"]}},
    {"name": "version string rejected", "filter": {"v": "1", "scope": "stocks"},
     "expect": {"ok": false, "errors": ["filter.v: must be 1"]}},
    {"name": "errors accumulate in order", "filter": {"v": 1, "scope": "stocks",
       "where": [{"field": "momentum_score", "op": ">", "value": 50}, {"field": "ret_12m", "op": ">", "value": 0.1},
                 {"field": "pe", "op": "~", "value": 1}],
       "sort": {"field": "ret_1m"}, "limit": -3},
     "expect": {"ok": false, "errors": ["where[0].field: unknown field 'momentum_score'", "where[1].field: unknown field 'ret_12m'",
       "where[2].op: '~' is not allowed for P/E (use <, <=, >, >=, =, !=, between)",
       "filter.sort.field: unknown field 'ret_1m'", "filter.limit: must be a whole number from 1 to 500"]}}
  ],

  "evaluate": [
    {"name": "default hides rows failing data checks", "fixture": "stocks",
     "filter": {"scope": "stocks", "where": [{"field": "pe", "op": "<=", "value": 20}]},
     "expect": {"keys": ["FXA", "FXC", "FXD", "FXE", "FXL"], "total": 5}},
    {"name": "include_flagged shows them", "fixture": "stocks",
     "filter": {"scope": "stocks", "where": [{"field": "pe", "op": "<=", "value": 20}], "include_flagged": true},
     "expect": {"keys": ["FXA", "FXC", "FXD", "FXE", "FXG", "FXI", "FXL"], "total": 7}},
    {"name": "!= never matches null", "fixture": "stocks",
     "filter": {"scope": "stocks", "where": [{"field": "pe", "op": "!=", "value": 18}]},
     "expect": {"keys": ["FXB", "FXC", "FXD", "FXE", "FXF", "FXK", "FXL", "FXM"], "total": 8}},
    {"name": "sort asc, nulls last", "fixture": "stocks", "filter": {"scope": "stocks", "sort": {"field": "pe", "dir": "asc"}},
     "expect": {"keys": ["FXD", "FXC", "FXL", "FXE", "FXA", "FXF", "FXB", "FXK", "FXM", "FXH"], "total": 10}},
    {"name": "sort desc, nulls still last", "fixture": "stocks", "filter": {"scope": "stocks", "sort": {"field": "pe", "dir": "desc"}},
     "expect": {"keys": ["FXM", "FXK", "FXB", "FXF", "FXA", "FXE", "FXL", "FXC", "FXD", "FXH"], "total": 10}},
    {"name": "limit applies after sort; total before limit", "fixture": "stocks",
     "filter": {"scope": "stocks", "sort": {"field": "value_score", "dir": "desc"}, "limit": 3},
     "expect": {"keys": ["FXD", "FXC", "FXA"], "total": 10}},
    {"name": "ties keep input order (desc)", "fixture": "stocks",
     "filter": {"scope": "stocks", "sort": {"field": "rev_cagr", "dir": "desc"}},
     "expect": {"keys": ["FXM", "FXH", "FXA", "FXB", "FXF", "FXC", "FXK", "FXE", "FXD", "FXL"], "total": 10}},
    {"name": "ties keep input order (asc)", "fixture": "stocks",
     "filter": {"scope": "stocks", "sort": {"field": "rev_cagr", "dir": "asc"}, "limit": 4},
     "expect": {"keys": ["FXD", "FXE", "FXC", "FXK"], "total": 10}},
    {"name": "between is inclusive", "fixture": "stocks",
     "filter": {"scope": "stocks", "where": [{"field": "dividend_yield", "op": "between", "value": [0.02, 0.045]}]},
     "expect": {"keys": ["FXB", "FXC", "FXE", "FXK"], "total": 4}},
    {"name": "enum in via synonyms", "fixture": "stocks",
     "filter": {"scope": "stocks", "where": [{"field": "sector", "op": "in", "value": ["tech", "health care"]}]},
     "expect": {"keys": ["FXA", "FXB", "FXM"], "total": 3}},
    {"name": "enum not_in", "fixture": "stocks",
     "filter": {"scope": "stocks", "where": [{"field": "sector", "op": "not_in", "value": ["Technology"]}], "include_flagged": true},
     "expect": {"keys": ["FXB", "FXC", "FXD", "FXE", "FXF", "FXG", "FXH", "FXI", "FXJ", "FXK", "FXL"], "total": 11}},
    {"name": "contains is case-insensitive", "fixture": "stocks",
     "filter": {"scope": "stocks", "where": [{"field": "name", "op": "contains", "value": "FIXTURE ALPHA"}]},
     "expect": {"keys": ["FXA"], "total": 1}},
    {"name": "list contains (strategies)", "fixture": "stocks",
     "filter": {"scope": "stocks", "where": [{"field": "strategies", "op": "contains", "value": "on_sale"}]},
     "expect": {"keys": ["FXA", "FXB", "FXC"], "total": 3}},
    {"name": "list contains substring", "fixture": "stocks",
     "filter": {"scope": "stocks", "where": [{"field": "strategies", "op": "contains", "value": "Steady"}]},
     "expect": {"keys": ["FXA"], "total": 1}},
    {"name": "data_flags contains (flagged rows)", "fixture": "stocks",
     "filter": {"scope": "stocks", "where": [{"field": "data_flags", "op": "contains", "value": "foreign"}], "include_flagged": true},
     "expect": {"keys": ["FXG", "FXN"], "total": 2}},
    {"name": "is_false", "fixture": "stocks",
     "filter": {"scope": "stocks", "where": [{"field": "value_trap", "op": "is_false"}]},
     "expect": {"keys": ["FXA", "FXB", "FXC", "FXE", "FXF", "FXH", "FXK", "FXL", "FXM"], "total": 9}},
    {"name": "is_true + sort by discount", "fixture": "stocks",
     "filter": {"scope": "stocks", "where": [{"field": "on_sale", "op": "is_true"}], "sort": {"field": "discount_long", "dir": "asc"}},
     "expect": {"keys": ["FXB", "FXC", "FXA"], "total": 3}},
    {"name": "data_ok is_false needs include_flagged", "fixture": "stocks",
     "filter": {"scope": "stocks", "where": [{"field": "data_ok", "op": "is_false"}], "include_flagged": true},
     "expect": {"keys": ["FXG", "FXI", "FXJ", "FXN"], "total": 4}},
    {"name": "data_ok is_false without include_flagged matches nothing", "fixture": "stocks",
     "filter": {"scope": "stocks", "where": [{"field": "data_ok", "op": "is_false"}]},
     "expect": {"keys": [], "total": 0}},
    {"name": "text = case-insensitive", "fixture": "stocks",
     "filter": {"scope": "stocks", "where": [{"field": "ticker", "op": "=", "value": "fxa"}]},
     "expect": {"keys": ["FXA"], "total": 1}},
    {"name": "text in (watchlist screen)", "fixture": "stocks",
     "filter": {"scope": "stocks", "where": [{"field": "ticker", "op": "in", "value": ["fxc", "FXA", "ZZZ"]}]},
     "expect": {"keys": ["FXA", "FXC"], "total": 2}},
    {"name": "text not_in", "fixture": "stocks",
     "filter": {"scope": "stocks", "where": [{"field": "ticker", "op": "not_in", "value": ["FXA"]}]},
     "expect": {"keys": ["FXB", "FXC", "FXD", "FXE", "FXF", "FXH", "FXK", "FXL", "FXM"], "total": 9}},
    {"name": "sort by text", "fixture": "stocks", "filter": {"scope": "stocks", "sort": {"field": "name", "dir": "asc"}},
     "expect": {"keys": ["FXA", "FXB", "FXD", "FXE", "FXC", "FXK", "FXL", "FXM", "FXH", "FXF"], "total": 10}},
    {"name": "sort by bool is stable", "fixture": "stocks", "filter": {"scope": "stocks", "sort": {"field": "on_sale", "dir": "desc"}},
     "expect": {"keys": ["FXA", "FXB", "FXC", "FXD", "FXE", "FXF", "FXH", "FXK", "FXL", "FXM"], "total": 10}},
